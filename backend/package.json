{
  "name": "combats-backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "db:local:up": "docker compose -f docker-compose.mongo.yml up -d",
    "db:local:down": "docker compose -f docker-compose.mongo.yml down",
    "db:local:logs": "docker compose -f docker-compose.mongo.yml logs -f mongo",
    "build": "tsc",
    "dev": "npm run dev:local",
    "dev:local": "set \"BK_APP_ENV_FILE=.env.local\" && nodemon --watch src --ext ts --exec tsx src/server.ts",
    "dev:prod": "set \"BK_APP_ENV_FILE=.env.prod\" && nodemon --watch src --ext ts --exec tsx src/server.ts",
    "start": "npm run start:local",
    "start:local": "set \"BK_APP_ENV_FILE=.env.local\" && node dist/server.js",
    "start:prod": "set \"BK_APP_ENV_FILE=.env.prod\" && node dist/server.js",
    "backup:export-raw": "tsx src/scripts/exportMongoBackup.ts",
    "backup:export-raw:prod": "set \"BK_APP_ENV_FILE=.env.prod\" && tsx src/scripts/exportMongoBackup.ts",
    "backup:export-start-data": "tsx src/scripts/exportStartDataBackup.ts",
    "backup:export-start-data:local": "set \"BK_APP_ENV_FILE=.env.local\" && tsx src/scripts/exportStartDataBackup.ts",
    "backup:import-new-schema": "tsx src/scripts/importBackupToNewSchema.ts",
    "backup:upgrade-project-game-config": "tsx src/scripts/upgradeProjectGameConfigBackup.ts",
    "backup:restore-new-schema": "tsx src/scripts/restoreNewSchemaBackup.ts",
    "backup:restore-new-schema:local": "set \"BK_APP_ENV_FILE=.env.local\" && tsx src/scripts/restoreNewSchemaBackup.ts",
    "backup:restore-new-schema:prod": "set \"BK_APP_ENV_FILE=.env.prod\" && tsx src/scripts/restoreNewSchemaBackup.ts",
    "db:migrate:journey-jackpot-count-mode": "tsx src/scripts/migrateJourneyJackpotCountMode.ts",
    "db:migrate:journey-jackpot-count-mode:local": "set \"BK_APP_ENV_FILE=.env.local\" && tsx src/scripts/migrateJourneyJackpotCountMode.ts",
    "db:migrate:journey-jackpot-count-mode:prod": "set \"BK_APP_ENV_FILE=.env.prod\" && tsx src/scripts/migrateJourneyJackpotCountMode.ts",
    "db:migrate:journey-cell-catalog": "tsx src/scripts/migrateJourneyCellCatalog.ts",
    "db:migrate:journey-cell-catalog:local": "set \"BK_APP_ENV_FILE=.env.local\" && tsx src/scripts/migrateJourneyCellCatalog.ts",
    "db:migrate:journey-cell-catalog:prod": "set \"BK_APP_ENV_FILE=.env.prod\" && tsx src/scripts/migrateJourneyCellCatalog.ts",
    "db:migrate:project-currency-metadata": "tsx src/scripts/migrateProjectCurrencyMetadata.ts",
    "db:migrate:project-currency-metadata:local": "set \"BK_APP_ENV_FILE=.env.local\" && tsx src/scripts/migrateProjectCurrencyMetadata.ts",
    "db:migrate:project-currency-metadata:prod": "set \"BK_APP_ENV_FILE=.env.prod\" && tsx src/scripts/migrateProjectCurrencyMetadata.ts",
    "db:migrate:resources-rewards": "tsx src/scripts/migrateResourcesAndJourneyRewards.ts",
    "db:migrate:resources-rewards:local": "set \"BK_APP_ENV_FILE=.env.local\" && tsx src/scripts/migrateResourcesAndJourneyRewards.ts",
    "db:migrate:resources-rewards:prod": "set \"BK_APP_ENV_FILE=.env.prod\" && tsx src/scripts/migrateResourcesAndJourneyRewards.ts",
    "db:migrate:game-config-reward-pools": "tsx src/scripts/migrateGameConfigRewardPools.ts",
    "db:migrate:game-config-reward-pools:local": "set \"BK_APP_ENV_FILE=.env.local\" && tsx src/scripts/migrateGameConfigRewardPools.ts",
    "db:migrate:game-config-reward-pools:prod": "set \"BK_APP_ENV_FILE=.env.prod\" && tsx src/scripts/migrateGameConfigRewardPools.ts",
    "db:replace-game-configs-from-backup:local": "set \"BK_APP_ENV_FILE=.env.local\" && tsx src/scripts/replaceLocalGameConfigsFromBackup.ts",
    "backup:prod": "npm run backup:restore-new-schema:prod -- --source backups\\db-data-projects --confirm-replace"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "mongodb": "^6.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.1",
    "nodemon": "^3.1.10",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
